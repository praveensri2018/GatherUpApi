{
  "info": {
    "name": "GatherUp – Phase 2 APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Phase 2 – Auth, User, Feed, Posts, Comments, Social, Media"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "post_id",
      "value": ""
    },
    {
      "key": "comment_id",
      "value": ""
    },
    {
      "key": "user_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{ \"mobile\": \"9000000001\", \"password\": \"123456\" }"
            }
          },
          "response": [
            {
              "name": "201 - User Registered",
              "status": "Created",
              "code": 201,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"message\": \"User registered successfully\",\n  \"data\": {\n    \"user_id\": \"uuid\"\n  }\n}"
            },
            {
              "name": "409 - User Exists",
              "status": "Conflict",
              "code": 409,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": false,\n  \"message\": \"User already exists\",\n  \"error_code\": \"USER_EXISTS\"\n}"
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{ \"mobile\": \"9000000001\", \"password\": \"123456\" }"
            }
          },
          "response": [
            {
              "name": "200 - Login Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"message\": \"Login successful\",\n  \"data\": {\n    \"access_token\": \"jwt_token\",\n    \"refresh_token\": \"refresh_token\",\n    \"expires_in\": 900,\n    \"user\": {\n      \"id\": \"uuid\",\n      \"mobile\": \"9000000001\"\n    }\n  }\n}"
            },
            {
              "name": "401 - Invalid Login",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"success\": false,\n  \"message\": \"Invalid credentials\",\n  \"error_code\": \"INVALID_LOGIN\"\n}"
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/auth/refresh"
          }
        },
        {
          "name": "Revoke Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/auth/revoke"
          }
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/api/me"
          },
          "response": [
            {
              "name": "200 - Profile",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"id\": \"uuid\",\n    \"mobile\": \"9000000001\",\n    \"email\": null,\n    \"username\": null,\n    \"created_at\": \"2025-12-10T08:30:00Z\"\n  }\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Feed",
      "item": [
        {
          "name": "Personalized Feed",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/posts/feed/personalized"
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create Post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/posts",
            "body": {
              "mode": "raw",
              "raw": "{ \"title\": \"Hello\", \"body\": \"Post body\", \"kind\": \"text\" }"
            }
          },
          "response": [
            {
              "name": "201 - Post Created",
              "status": "Created",
              "code": 201,
              "body": "{\n  \"success\": true,\n  \"message\": \"Post created\",\n  \"data\": {\n    \"post_id\": \"uuid\"\n  }\n}"
            }
          ]
        },
        {
          "name": "List Posts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/posts"
          },
          "response": [
            {
              "name": "200 - Posts List",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"data\": [\n    {\n      \"id\": \"uuid\",\n      \"author_id\": \"uuid\",\n      \"title\": \"Hello\",\n      \"body\": \"Post body\",\n      \"kind\": \"text\",\n      \"created_at\": \"2025-12-13T07:00:00Z\",\n      \"media\": []\n    }\n  ]\n}"
            }
          ]
        },
        {
          "name": "Get Post",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/posts/{{post_id}}"
          }
        },
        {
          "name": "Update Post",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/posts/{{post_id}}",
            "body": {
              "mode": "raw",
              "raw": "{ \"title\": \"Updated\", \"body\": \"Updated body\" }"
            }
          }
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/posts/{{post_id}}"
          }
        },
        {
          "name": "Upload Media",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/posts/{{post_id}}/media",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file"
                },
                {
                  "key": "media_type",
                  "value": "image",
                  "type": "text"
                },
                {
                  "key": "sort_order",
                  "value": "0",
                  "type": "text"
                }
              ]
            }
          }
        },
        {
          "name": "React Post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/posts/{{post_id}}/reactions"
          }
        },
        {
          "name": "Unreact Post",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/posts/{{post_id}}/reactions"
          }
        },
        {
          "name": "Report Post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/posts/{{post_id}}/report",
            "body": {
              "mode": "raw",
              "raw": "{ \"reason\": \"spam\" }"
            }
          }
        },
        {
          "name": "My Posts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/users/me/posts"
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Create Comment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/posts/{{post_id}}/comments",
            "body": {
              "mode": "raw",
              "raw": "{ \"body\": \"Nice post\" }"
            }
          }
        },
        {
          "name": "List Comments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/posts/{{post_id}}/comments"
          }
        },
        {
          "name": "Update Comment",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/comments/{{comment_id}}",
            "body": {
              "mode": "raw",
              "raw": "{ \"body\": \"Updated comment\" }"
            }
          }
        },
        {
          "name": "Delete Comment",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/comments/{{comment_id}}"
          }
        },
        {
          "name": "React Comment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/comments/{{comment_id}}/reactions"
          }
        },
        {
          "name": "Unreact Comment",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/comments/{{comment_id}}/reactions"
          }
        },
        {
          "name": "Report Comment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/comments/{{comment_id}}/report",
            "body": {
              "mode": "raw",
              "raw": "{ \"reason\": \"abuse\" }"
            }
          }
        }
      ]
    },
    {
      "name": "Social",
      "item": [
        {
          "name": "Bookmark Post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/posts/{{post_id}}/bookmark"
          }
        },
        {
          "name": "Unbookmark Post",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/posts/{{post_id}}/bookmark"
          }
        },
        {
          "name": "List Bookmarks",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/bookmarks"
          }
        },
        {
          "name": "Follow User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/users/{{user_id}}/follow"
          }
        },
        {
          "name": "Unfollow User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/users/{{user_id}}/unfollow"
          }
        },
        {
          "name": "Followers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/users/{{user_id}}/followers"
          }
        },
        {
          "name": "Following",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/users/{{user_id}}/following"
          }
        },
        {
          "name": "Block User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/blocks",
            "body": {
              "mode": "raw",
              "raw": "{ \"blocked_user_id\": \"{{user_id}}\", \"reason\": \"spam\" }"
            }
          }
        },
        {
          "name": "Unblock User",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/blocks",
            "body": {
              "mode": "raw",
              "raw": "{ \"blocked_user_id\": \"{{user_id}}\" }"
            }
          }
        },
        {
          "name": "List Blocked Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/blocks"
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          }
        }
      ]
    }
  ]
}