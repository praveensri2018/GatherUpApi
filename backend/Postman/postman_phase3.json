{
  "info": {
    "name": "GatherUp – Phase 3 APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Phase 3 – Profile, Feed, Posts, Comments, Social (as implemented)"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "user_id", "value": "" },
    { "key": "post_id", "value": "" },
    { "key": "comment_id", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{ \"mobile\": \"9000000001\", \"password\": \"123456\" }"
            }
          }
        }
      ]
    },
    {
      "name": "User / Profile",
      "item": [
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/me"
          }
        },
        {
          "name": "Get User Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/users/{{user_id}}"
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/users/me/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"display_name\": \"Alexandra Lee\",\n  \"username\": \"alex_lee\",\n  \"bio\": \"Photographer | Traveler\",\n  \"email\": \"alex@mail.com\",\n  \"gender\": \"female\"\n}"
            }
          }
        },
        {
          "name": "Update Avatar",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/users/me/avatar",
            "body": {
              "mode": "raw",
              "raw": "{ \"avatar_url\": \"https://cdn.gatherup.app/avatar/u1.png\" }"
            }
          }
        }
      ]
    },
    {
      "name": "Feed",
      "item": [
        {
          "name": "Personalized Feed",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/posts/feed/personalized?limit=10"
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create Post",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/posts",
            "body": {
              "mode": "raw",
              "raw": "{ \"title\": \"Hello\", \"body\": \"Post body\", \"kind\": \"text\" }"
            }
          }
        },
        {
          "name": "Like Post",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/posts/{{post_id}}/reactions"
          }
        },
        {
          "name": "Unlike Post",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/posts/{{post_id}}/reactions"
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Create Comment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/posts/{{post_id}}/comments",
            "body": {
              "mode": "raw",
              "raw": "{ \"body\": \"Nice post\" }"
            }
          }
        }
      ]
    },
    {
      "name": "Social",
      "item": [
        {
          "name": "Follow User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/users/{{user_id}}/follow"
          }
        },
        {
          "name": "Bookmark Post",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/posts/{{post_id}}/bookmark"
          }
        }
      ]
    }
  ]
}
